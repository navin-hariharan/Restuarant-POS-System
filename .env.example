# Copy to .env for docker compose (Dokploy: set these in the app's Environment tab)
DB_DATABASE=pos
DB_USERNAME=pos
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Public address, e.g. https://pos.example.com (optional; links are relative when empty)
APP_URL=
# First administrator of a new, empty database
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
APP_PORT=8080
